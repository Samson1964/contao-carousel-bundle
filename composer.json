{
    "name": "schachbulle/contao-caroufredsel-bundle",
    "type": "contao-bundle",
    "description": "Bildkarussell auf Basis des jQuery-Plugins carouFredSel: Galerie mit Vorschaubildern, Newsticker, Hintergrund-Slideshow und Karussell für beliebige Inhaltselemente.",
    "keywords": [
        "contao",
        "jquery",
        "karussell",
        "slider",
        "slideshow",
        "galerie",
        "newsticker",
        "caroufredsel"
    ],
    "homepage": "https://github.com/Samson1964/contao-caroufredsel-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        },
        {
            "name": "Dirk Klemmt",
            "role": "Entwickler der ursprünglichen Contao-3-Erweiterung dk_caroufredsel"
        },
        {
            "name": "Fred Heusschen",
            "role": "Entwickler des jQuery-Plugins carouFredSel"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^4.13 || ^5.0",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "suggest": {
        "contao/news-bundle": "Wird für das Frontend-Modul \"carouFredSel-Newsticker\" benötigt"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoCaroufredselBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoCaroufredselBundle\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-caroufredsel-bundle/issues",
        "source": "https://github.com/Samson1964/contao-caroufredsel-bundle"
    }
}
